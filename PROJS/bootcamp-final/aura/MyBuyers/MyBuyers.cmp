<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes" access="global" controller="MyBuyersController">
	<aura:handler name="init" value="{!this}" action="{!c.init}" />
    <aura:attribute name="isLoading" type="Boolean" />
    <aura:attribute name="tableData" type="Object" />
    <aura:attribute name="tableCols" type="Object" />
    
    <lightning:card title="My Buyers"
                    iconName="standard:groups"
                    class="slds-p-around_x-small">
        <lightning:datatable aura:id="itemsTable"
                             keyField="Id"
                             data="{!v.tableData}"
                             columns="{!v.tableCols}"
                             hideCheckboxColumn="true"
                             onrowaction="{!c.handleRowAction}"/>
        <aura:if isTrue="{!v.isLoading}">
            <lightning:spinner alternativeText="Loading..." />
        </aura:if>
    </lightning:card>
</aura:component>