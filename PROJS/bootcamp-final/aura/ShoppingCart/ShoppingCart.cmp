<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes"
                access="global"
                controller="ShoppingCartController">
    
    <aura:attribute name="tableData" type="Object[]" />
    <aura:attribute name="tableCols" type="Object" />
    <aura:attribute name="modalTableCols" type="Object" />
    <aura:attribute name="totalPrice" type="Decimal" default="0.00" />
    <aura:attribute name="displayModal" type="Boolean" default="false" />
	<aura:attribute name="buyer" type="Order__c" default="{sobjectType:'Order__c',
                                                          Buyer_Name__c: '',
                                                          Buyer_Phone__c: '',
                                                          Buyer_Address__c: ''}"/>
    <aura:attribute name="initialText" type="Boolean" default="true" />
    <aura:attribute name="cmpContent" type="Boolean" default="false" />
    
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <aura:handler event="c:PopulateShoppingCartEvt" action="{!c.handlePopulateShoppingCart}" />
    <aura:registerEvent name="removeItem" type="c:ShoppingCartRemoveEvt"/>
    <lightning:notificationsLibrary aura:id="notifLib"/>
    
    <lightning:card title="Shopping Cart" iconName="standard:webcart" class="slds-p-around_x-small">
        <aura:if isTrue="{!v.initialText}">
            <h1>To start. Add a product to your Shopping Cart!</h1>
        </aura:if>
        
        <aura:if isTrue="{!v.cmpContent}">
            <lightning:datatable aura:id="shoppingCartItems"
                                 keyField="ItemId"
                                 data="{!v.tableData}"
                                 columns="{!v.tableCols}"
                                 hideCheckboxColumn="true"
                                 onrowaction="{!c.handleRowAction}"/>
            <footer class="footer">
                <lightning:button label="Create Order"
                                  title="Create Order"
                                  onclick="{!c.toggleModal}"
                                  variant="brand"/>
                <div class="total-price">
                    <h3>Total</h3>
                    $ {!v.totalPrice}
                </div>
            </footer>
        </aura:if>
    </lightning:card>
    
    <!-- MODAL -->
    <aura:if isTrue="{!v.displayModal}">
        <section role="dialog"
                 tabindex="-1"
                 aria-labelledby="modal-heading-01"
                 aria-modal="true"
                 aria-describedby="modal-content-id-1"
                 class="slds-modal slds-fade-in-open slds-modal_large">
            <div class="slds-modal__container">
                <!-- Modal/Popup Box Header Starts here-->
                <header class="slds-modal__header">
                    <lightning:buttonIcon iconName="utility:close"
                                          onclick="{!c.toggleModal}"
                                          alternativeText="close"
                                          variant="bare-inverse"
                                          class="slds-modal__close"/>
                    <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">Invoice Summary</h2>
                </header>
                <!-- Modal/Popup Box MAIN Starts here-->
                <lightning:card class="slds-p-around_x-small">
                    <form class="slds-grid slds-gutters slds-wrap" style="margin-bottom:2rem">
                        <div class="slds-col ">
                            <lightning:input label="Full Name" value="{!v.buyer.Buyer_Name__c}" required="true" />
                        </div>
                        <div class="slds-col">
                            <lightning:input label="Phone" value="{!v.buyer.Buyer_Phone__c}" required="true" />
                        </div>
                        <div class="slds-col slds-size_6-of-12">
                            <lightning:input label="Shipping Address" value="{!v.buyer.Buyer_Address__c}" required="true" />
                        </div>
                    </form>
                    
                    <lightning:datatable aura:id="motalTable"
                                         keyField="ItemId"
                                         data="{!v.tableData}"
                                         columns="{!v.modalTableCols}"
                                         hideCheckboxColumn="true"/>
                    <div class="total-price">
                        $ {!v.totalPrice}
                    </div>
                </lightning:card>
                <!--Modal/Popup Box Footer Starts here-->
                <footer class="slds-modal__footer">
                    <lightning:button variant="neutral"
                                      label="Cancel"
                                      title="Cancel"
                                      onclick="{! c.toggleModal}"/>
                    <lightning:button variant="brand"
                                      label="Confirm"
                                      title="Confirm"
                                      onclick="{!c.createOrder}"/>
                </footer>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
</aura:component>