<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,force:appHostable,flexipage:availableForAllPageTypes" access="global" controller="MostDemandedItemsController" >
	<aura:attribute name="mydata" type="Object"/>
    <aura:attribute name="mycolumns" type="List"/>
    <aura:handler name="init" value="{! this }" action="{! c.init }"/>
    <aura:registerEvent name="registerItem" type="c:RegisterItemRow"/>
    <!--Display Table -->
    <lightning:card iconName="utility:arrowup" title="Best Sellers and Newest Items" class="slds-p-around_x-small">
        <div class="slds-m-around_small slds-border_top slds-border_right slds-border_bottom slds-border_left">
            <lightning:datatable data="{! v.mydata }"
                                 columns="{! v.mycolumns }"
                                 keyField="Id"
                                 onrowselection="{! c.updateSelectedRow }"
                                 maxRowSelection = "10"/>
        </div>
    </lightning:card>
</aura:component>